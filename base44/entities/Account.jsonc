{
  "name": "Account",
  "type": "object",
  "properties": {
    "account_number": {
      "type": "string",
      "description": "10-digit account number"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "checking",
        "savings"
      ],
      "default": "checking"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "frozen",
        "closed"
      ],
      "default": "active"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the account owner"
    },
    "owner_name": {
      "type": "string"
    }
  },
  "required": [
    "account_number",
    "owner_email"
  ]
}